{
  "schemaVersion": 1,
  "id": "meteor-zh",
  "version": "1.3.1",
  "name": "Meteor 中文汉化 (Meteor-ZH)",
  "description": "Meteor Client 全界面简体中文汉化：模块名、功能描述、设置项名称与描述、设置分组、按键名（Bind）、HUD 元素、顶部标签页，以及 GUI 里硬编码的按钮/提示文字。启动后自动翻译，无需任何手动操作，重启后依旧生效；新安装的附属模组会在下次启动时被自动识别并翻译（词典未收录的条目用内置词表逐词合成）。由 dsh-woo4005 开发，DeepSeek V4.1 flash 1017 协助完成。",
  "authors": [
    "dsh-woo4005",
    "DeepSeek V4.1 flash 1017"
  ],
  "contact": {
    "homepage": "https://github.com/wzy080532/meteor-zh",
    "sources": "https://github.com/wzy080532/meteor-zh",
    "issues": "https://github.com/wzy080532/meteor-zh/issues"
  },
  "license": "CC0-1.0",
  "icon": "assets/meteorzh/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.meteorzh.MeteorZh"
    ]
  },
  "mixins": [
    "meteor-zh.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=1.21.9"
  }
}
